# Kuota — variables de entorno para desarrollo local (FR-004).
# Copia este archivo a `.env` (ignorado por Git) y sustituye los valores. Todos los valores de aquí son FICTICIOS:
# no son secretos reales y no deben usarse fuera de una máquina de desarrollo.

# --- Servicio central -------------------------------------------------------------------------------------------
# Entorno: local | testing | staging | production.
KUOTA_ENV=local
# Contexto técnico de empresa (R-05). Solo `enabled` en local/testing; el arranque aborta en staging/production.
KUOTA_DEV_TENANT_CONTEXT=enabled
# Puerto HTTP de la API.
PORT=3000
# Nivel de log de pino: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
# Versión de la API publicada por /v1/meta/compatibility.
API_VERSION=1.0.0
# Versión mínima soportada por app (semver), expuesta por /v1/meta/compatibility.
MIN_SUPPORTED_ADMIN=0.1.0
MIN_SUPPORTED_COLLECTOR=0.1.0
MIN_SUPPORTED_CLIENT=0.1.0

# --- Métricas (research R-21; Constitución §II) -------------------------------------------------------------------
# Escucha interna de métricas; por defecto solo loopback. Fuera de local/testing el token es obligatorio (≥ 32).
KUOTA_METRICS_HOST=127.0.0.1
KUOTA_METRICS_PORT=9464
KUOTA_METRICS_TOKEN=ficticio-token-metricas-solo-local-0000

# --- PostgreSQL local (infra/docker/compose.yaml, R-18) ---------------------------------------------------------
# Puerto del host (solo 127.0.0.1). 55432 evita choques con un PostgreSQL local en 5432.
KUOTA_PG_HOST_PORT=55432
# Superusuario del contenedor: solo lo usa el script de inicialización; nunca la aplicación.
POSTGRES_PASSWORD=ficticio-superusuario-solo-local
# Contraseñas de los roles creados por infra/docker/postgres/init/01-roles.sql (mínimo 12 caracteres).
KUOTA_MIGRATOR_PASSWORD=ficticio-migrator-solo-local
KUOTA_APP_LOGIN_PASSWORD=ficticio-app-login-solo-local
# Conexión de la API: rol kuota_app_login (sin BYPASSRLS, no propietario).
DATABASE_URL_APP=postgresql://kuota_app_login:ficticio-app-login-solo-local@127.0.0.1:55432/kuota
# Conexión de migraciones: rol kuota_migrator (propietario). Nunca la usa la API en runtime.
DATABASE_URL_MIGRATOR=postgresql://kuota_migrator:ficticio-migrator-solo-local@127.0.0.1:55432/kuota
