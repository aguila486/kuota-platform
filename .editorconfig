root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# Archivos de proyecto de Xcode (apps iOS, T085): Xcode decide su indentación (tabuladores en .pbxproj y en la mayoría de
# .plist, espacios en .xcscheme y AppFrameworkInfo.plist) y la reescribe al guardar. Solo se deja libre la indentación;
# siguen sujetos al resto de reglas (UTF-8, LF, salto final, sin espacios finales).
[*.{pbxproj,plist,xcsettings,xcscheme}]
indent_style = unset
