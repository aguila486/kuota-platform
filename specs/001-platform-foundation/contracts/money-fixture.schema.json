{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kuota.local/schemas/money-fixture.schema.json",
  "title": "Kuota money fixture file",
  "description": "Casos numéricos compartidos backend/Dart (R-09). Se materializa en contracts/fixtures/money/fixture.schema.json.",
  "type": "object",
  "required": ["schema_version", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "required": ["amount_minor", "currency"],
      "additionalProperties": false,
      "properties": {
        "amount_minor": { "type": "string", "pattern": "^-?\\d{1,30}$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "rounding": { "enum": ["HALF_UP", "HALF_EVEN", "DOWN", "UP", "FLOOR", "CEILING"] },
    "case": {
      "type": "object",
      "required": ["id", "operation", "inputs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "description": { "type": "string" },
        "operation": { "enum": ["add", "subtract", "multiply", "allocate", "parse", "format"] },
        "inputs": {
          "type": "object",
          "properties": {
            "a": { "$ref": "#/$defs/money" },
            "b": { "$ref": "#/$defs/money" },
            "factor": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" },
            "parts": { "type": "integer", "minimum": 1 },
            "ratios": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        "rounding": { "$ref": "#/$defs/rounding" },
        "expected": {
          "oneOf": [
            { "$ref": "#/$defs/money" },
            { "type": "array", "items": { "$ref": "#/$defs/money" } },
            { "type": "string" }
          ]
        },
        "expected_error": {
          "enum": ["CURRENCY_MISMATCH", "ROUNDING_REQUIRED", "INVALID_AMOUNT", "TOO_MANY_DECIMALS"]
        }
      },
      "oneOf": [
        { "required": ["expected"] },
        { "required": ["expected_error"] }
      ]
    }
  }
}
