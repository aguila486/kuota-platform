{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kuota Core: monolito modular NestJS (ADR-0002).",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "pnpm run prisma:generate && nest start --watch",
    "build": "pnpm run prisma:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run prisma:generate && eslint . && pnpm run lint:deps",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run prisma:generate && vitest run",
    "test:cov": "pnpm run prisma:generate && vitest run --coverage",
    "spike:rls": "KUOTA_SPIKE=1 vitest run --reporter=verbose",
    "prisma:generate": "prisma generate --no-hints",
    "db:check-rls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-rls.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/terminus": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "decimal.js": "10.6.0",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.1",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "testcontainers": "12.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
